# Manager web environment template. Copy to .env.local for local overrides.
#
# WARNING: Vite inlines every VITE_-prefixed variable into the built JavaScript
# bundle. Anything here is PUBLIC. Never put a secret, token or password in this
# file or any .env used by this app. See docs/SECURITY.md section 5.
#
# Use "localhost", not "127.0.0.1". The refresh token is an HttpOnly cookie with
# SameSite=strict, and SameSite compares registrable domains: localhost:5173 and
# localhost:8000 are the SAME site (ports are ignored), while localhost:5173 and
# 127.0.0.1:8000 are DIFFERENT sites. With 127.0.0.1 the browser silently drops
# the cookie and the session does not survive a page reload.
VITE_API_BASE_URL=http://localhost:8000
