# Manager web environment template. Copy to .env.local for local overrides.
#
# WARNING: Vite inlines every VITE_-prefixed variable into the built JavaScript
# bundle. Anything here is PUBLIC. Never put a secret, token or password in this
# file or any .env used by this app. See docs/SECURITY.md section 5.

VITE_API_BASE_URL=http://127.0.0.1:8000
