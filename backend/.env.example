# NER Fleet Intelligence - backend environment template
#
# Copy to .env and fill in real values:   copy .env.example .env
#
# .env is git-ignored and MUST NOT be committed.
# This file contains PLACEHOLDERS ONLY - never put a real secret here.

# --- Application ---
APP_NAME="NER Fleet Intelligence API"
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# --- Security ---
# Generate a real key before anything other than local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The application REFUSES TO START with this placeholder when APP_ENV is not
# "development". See docs/SECURITY.md section 5.
SECRET_KEY=change-me-generate-a-real-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===========================================================================
# DATABASE
# ===========================================================================
# PRIMARY DATABASE:            Supabase PostgreSQL + PostGIS
# OPTIONAL LOCAL FALLBACK:     WSL2 PostgreSQL + PostGIS
#
# DATABASE_PROVIDER selects which connection is used. There is NO automatic
# fallback: if Supabase is unreachable in supabase mode, the application reports
# a failure rather than quietly serving stale local data.
#
#   supabase -> uses DATABASE_URL        (rejected if it points at localhost)
#   local    -> uses LOCAL_DATABASE_URL  (requires scripts\db-start.ps1)
DATABASE_PROVIDER=supabase

# --- Supabase connection ---
# Get this from the Supabase dashboard: Connect -> Session pooler.
#
# Use the SESSION POOLER (port 5432), not the transaction pooler (6543):
#   - the session pooler is IPv4, while direct db.<ref>.supabase.co is IPv6-only
#   - the transaction pooler does not support the prepared statements psycopg
#     uses, and is unsafe for Alembic DDL
#
# Replace the driver prefix with postgresql+psycopg:// and URL-encode any
# special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_POOLER_HOST:5432/postgres

# Optional. Alembic uses this when set, otherwise DATABASE_URL. Provided because
# Supabase pooling modes have different DDL characteristics - see
# docs/ARCHITECTURE.md section 10.
# MIGRATION_DATABASE_URL=

# --- Optional local development database (WSL2) ---
# Only used when DATABASE_PROVIDER=local. Requires scripts\db-start.ps1.
# LOCAL_DATABASE_URL=postgresql+psycopg://ner:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/ner_logistics

# --- Supabase project identifiers ---
# Project URL is not a secret.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable/anon key. Safe to expose by design, but NOT NEEDED YET - the
# clients talk to FastAPI, never to Supabase directly.
# SUPABASE_ANON_KEY=

# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file, in any client, or in git.
# It bypasses row-level security entirely. It is not required for this phase,
# and when it is eventually needed it belongs in backend/.env only.

# Supabase's session pooler allows only 15 clients per PROJECT, shared
# across every connected process. Keep pool_size + max_overflow well
# under that so a running dev server and a test run can coexist.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_ECHO=false
DB_CONNECT_TIMEOUT_SECONDS=5
# Managed databases must use TLS. Automatically relaxed for provider=local.
DB_REQUIRE_SSL=true

# --- CORS ---
# Comma-separated explicit origins. Never "*" together with credentials.
#   5173 = manager web (Vite)
#   8081 = driver app running on the Expo web target. A driver app on a real
#          device is a native client and is not subject to CORS at all.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
