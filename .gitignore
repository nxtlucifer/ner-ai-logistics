# ---------------------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------------------
# .env files hold real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets/
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
dist/
build/

# ---------------------------------------------------------------------------
# Node / frontend / mobile
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
manager-web/dist/
manager-web/.vite/
.expo/
driver-app/.expo/
driver-app/dist/
driver-app/android/
driver-app/ios/
*.tsbuildinfo
.eslintcache

# ---------------------------------------------------------------------------
# ML artefacts
# ---------------------------------------------------------------------------
# Trained models are versioned artefacts stored outside git - see
# docs/AI_MODELS.md section 6. Never commit a model binary.
ml/artifacts/
ml/runs/
*.pkl
*.joblib
*.onnx
*.txt.model

# Raw and generated datasets. data/README.md explains what belongs here.
data/raw/
data/processed/
data/generated/
*.parquet
!data/**/.gitkeep

# ---------------------------------------------------------------------------
# Uploads - driver documents, truck photos, proof of delivery.
# These are personal data. They must never enter version control.
# ---------------------------------------------------------------------------
uploads/
media/
backend/uploads/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
.scratch/

# ---------------------------------------------------------------------------
# Local isolated database runtime (LS-7 / LS-12)
# ---------------------------------------------------------------------------
# Postgres binaries, cluster data, the password file and every built APK live
# here. This was previously only in .git/info/exclude, which protects one
# clone on one machine and nobody else's. Tracked so the protection travels.
.runtime/

# ---------------------------------------------------------------------------
# Android build outputs
# ---------------------------------------------------------------------------
# EAS artefacts are downloaded, not authored. They are large binaries and a
# release is identified by its EAS build id, not by a copy in the tree.
*.apk
*.aab

# ---------------------------------------------------------------------------
# Supabase CLI local state
# ---------------------------------------------------------------------------
# Written by `supabase link`. Carries the linked project ref and the pooler
# URL - infrastructure detail that does not belong in a public repository.
supabase/.temp/

# ---------------------------------------------------------------------------
# Agent and developer-tool scratch
# ---------------------------------------------------------------------------
# Session state, caches, transcripts and per-machine tool credentials written
# into the tree by assistants and CLIs. None of it is project source, some of
# it is a live token (.semgrep/guardian.yml), and some of it is a verbatim
# conversation log (.claude/chat-exports/).
.claude/
.artibot/
.context-os/
.coworker/
.codex/
.thumbgate/
.agentic-security/
.semgrep/
memory/.dreams/

# ---------------------------------------------------------------------------
# Prompt and conversation dumps
# ---------------------------------------------------------------------------
# Working files created while briefing an assistant. Deterministic names, so
# they can be matched; never part of the project.
full_user_request*.txt
latest_user_prompt*.txt
mission_prompt*.txt
scratch_user_prompt*.txt
